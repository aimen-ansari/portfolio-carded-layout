# Contact-form delivery (Resend)
# ===========================================================================
# The contact form sends inquiries to info@aimenansari.com through Resend,
# via a server function (src/server-fns/send-inquiry.ts) so the API key
# never reaches the browser.
#
# If no key is configured, the form still works: it opens the visitor's
# mail client with the message pre-filled to info@aimenansari.com.
#
# Copy this file to `.env` (gitignored) and fill in real values, or set the
# variables in your hosting dashboard (e.g. Lovable → Settings → Secrets).
# ---------------------------------------------------------------------------

# REQUIRED for automatic delivery.
# Create a key at https://resend.com/api-keys  (starts with "re_").
# NEVER prefix this with VITE_ — VITE_ variables are shipped to every browser
# and a Resend key would let anyone send email as your account.
RESEND_API_KEY=

# OPTIONAL sender identity (needs a domain verified in Resend → Domains).
# Defaults to: Aimen Ansari <info@aimenansari.com>
RESEND_FROM=

# QUICK TEST MODE — while your sending domain is unverified, Resend only
# delivers from its test sender "onboarding@resend.dev" and only to the email
# address that owns the Resend account. Set BOTH values to test the form
# end-to-end without any DNS setup, then delete them once the domain is
# verified (Resend → Domains → add aimenansari.com → paste the 3 DNS records).
# RESEND_TEST_MODE=true
# RESEND_TEST_INBOX=you@your-resend-account.com
